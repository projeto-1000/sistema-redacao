{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "PAGARME_SECRET_KEY",
    "NEXT_PUBLIC_PAGARME_PUBLIC_KEY",
    "SUPABASE_SECRET_KEY",
    "CRON_SECRET",
    "HOTMART_WEBHOOK_TOKEN",
    "VERCEL_BYPASS_SECRET",
    "HOTMART_MENTORSHIP_PRODUCT_UCODE",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
