{
  "name": "sistema-redacao",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:tailwind": "pnpm --filter admin lint:tailwind && pnpm --filter students lint:tailwind && pnpm --filter teachers lint:tailwind && pnpm --filter website lint:tailwind && pnpm --filter @repo/ui lint:tailwind",
    "check-types": "turbo run check-types",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "2.119.0",
    "turbo": "^2.11.7"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  }
}
